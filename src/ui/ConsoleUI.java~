    private void printTable(List<Contact> contacts) {
        if (contacts.isEmpty()) {
            System.out.println("Không có danh bạ nào để hiển thị.");
            return;
        }
        int pageSize = 5;
        int totalItems = contacts.size();
        int totalPages = (int) Math.ceil((double) totalItems / pageSize);
        int currentPage = 1;

        while (true) {
            System.out.println("\n+-----+----------------------+---------------+------------+-----------+------------+-------------------------------+");
            System.out.printf("| %-3s | %-20s | %-13s | %-10s | %-9s | %-10s | %-29s |\n", 
                    "STT", "Họ tên", "Số điện thoại", "Nhóm", "Giới tính", "Ngày sinh", "Email");
            System.out.println("+-----+----------------------+---------------+------------+-----------+------------+-------------------------------+");
            
            int start = (currentPage - 1) * pageSize;
            int end = Math.min(start + pageSize, totalItems);
            for (int i = start; i < end; i++) {
                Contact c = contacts.get(i);
                String birthdayStr = c.getBirthday() != null ? c.getBirthday().format(Validator.DATE_FORMATTER) : "N/A";
                System.out.printf("| %-3d | %-20s | %-13s | %-10s | %-9s | %-10s | %-29s |\n",
                        (i + 1),
                        truncate(c.getFullName(), 20),
                        truncate(c.getPhone(), 13),
                        truncate(c.getGroup(), 10),
                        c.getGender().name(),
                        birthdayStr,
                        truncate(c.getEmail(), 29)
                );
            }
            System.out.println("+-----+----------------------+---------------+------------+-----------+------------+-------------------------------+");
            System.out.printf("Trang %d/%d (Tổng số danh bạ: %d)\n", currentPage, totalPages, totalItems);
            if (totalPages <= 1) {
                break;
            }
            System.out.print("Nhập N (Trang tiếp), P (Trang trước), Q (Quay lại): ");
            String choice = scanner.nextLine().trim().toUpperCase();
            if (choice.equals("N")) {
                if (currentPage < totalPages) {
                    currentPage++;
                } else {
                    System.out.println("Đã ở trang cuối.");
                }
            } else if (choice.equals("P")) {
                if (currentPage > 1) {
                    currentPage--;
                } else {
                    System.out.println("Đã ở trang đầu.");
                }
            } else if (choice.equals("Q") || choice.isEmpty()) {
                break;
            } else {
                System.out.println("Lựa chọn không hợp lệ.");
            }
        }
    }

    private String truncate(String text, int maxLength) {
        if (text == null) return "";
        if (text.length() <= maxLength) return text;
        return text.substring(0, maxLength - 3) + "...";
    }
