    private void viewContactsFlow() {
        List<Contact> list = contactService.getAllContacts();
        if (list.isEmpty()) {
            System.out.println("Danh bạ trống.");
            return;
        }

        System.out.println("\nSắp xếp theo:");
        System.out.println("  A. Họ tên (A→Z)");
        System.out.println("  B. Họ tên (Z→A)");
        System.out.println("  C. Ngày sinh (cũ → mới)");
        System.out.println("  D. Nhóm (A→Z), sau đó Họ tên (A→Z)");
        System.out.println("  E. Không sắp xếp (giữ nguyên thứ tự nhập)");
        System.out.print("Chọn: ");
        String sortOption = scanner.nextLine().trim();

        System.out.println("\nLọc danh sách (Enter để bỏ qua):");
        System.out.print("  Nhóm: ");
        String filterGroup = scanner.nextLine().trim();
        System.out.print("  Giới tính (MALE/FEMALE/OTHER): ");
        String filterGenderStr = scanner.nextLine().trim().toUpperCase();

        Gender filterGender = null;
        if (!filterGenderStr.isEmpty()) {
            try {
                filterGender = Gender.valueOf(filterGenderStr);
            } catch (IllegalArgumentException e) {
                System.out.println("Giới tính không hợp lệ, bỏ qua lọc theo giới tính.");
            }
        }

        final String finalFilterGroup = filterGroup;
        final Gender finalFilterGender = filterGender;
        List<Contact> result = list.stream()                 // stream API chuyển List<Contact> thành một Stream<Contact> để xử lý dữ liệu bằng Stream API
                .filter(c -> {                               // lambda
                    if (finalFilterGroup.isEmpty()) return true;
                    return c.getGroup().equalsIgnoreCase(finalFilterGroup);
                })
                .filter(c -> {
                    if (finalFilterGender == null) return true;
                    return c.getGender() == finalFilterGender;
                })
                .collect(Collectors.toList());

        result = sortContacts(result, sortOption);

        printTable(result);
    }

    private List<Contact> sortContacts(List<Contact> list, String sortOption) {
        List<Contact> sorted = new ArrayList<>(list);
        switch (sortOption.toUpperCase()) {
            case "A":
                sorted.sort(Comparator.comparing(Contact::getFullName, String.CASE_INSENSITIVE_ORDER)); // Comparator sắp xếp
                break;
            case "B":
                sorted.sort(Comparator.comparing(Contact::getFullName, String.CASE_INSENSITIVE_ORDER).reversed()); // reversed() đảo ngược kết quả
                break;
            case "C":
                sorted.sort((c1, c2) -> {
                    if (c1.getBirthday() == null && c2.getBirthday() == null) return 0;
                    if (c1.getBirthday() == null) return 1;
                    if (c2.getBirthday() == null) return -1;
                    return c1.getBirthday().compareTo(c2.getBirthday());
                });
                break;
            case "D":
                sorted.sort(Comparator.comparing(Contact::getGroup, String.CASE_INSENSITIVE_ORDER)
                        .thenComparing(Contact::getFullName, String.CASE_INSENSITIVE_ORDER));   // thenComparing() dùng để sắp xếp nhiều tiêu chí
                break;
            case "E":
            default:
                break;
        }
        return sorted;
    }

    private void addContactFlow() {
        System.out.println("\n--- THÊM MỚI DANH BẠ ---");
        try {
            System.out.print("Nhập số điện thoại (bắt buộc): ");
            String phone = scanner.nextLine().trim();
            Validator.validatePhone(phone);

            System.out.print("Nhập họ tên (bắt buộc): ");
            String fullName = scanner.nextLine().trim();
            Validator.validateRequired(fullName, "Họ tên");

            String group = "";
            while (group.isEmpty()) {
                System.out.print("Nhập nhóm (bắt buộc): ");
                group = scanner.nextLine().trim();
                if (group.isEmpty()) {
                    System.out.println("Nhóm không được để trống. Vui lòng nhập lại.");
                }
            }

            Gender gender = null;
            while (gender == null) {
                System.out.print("Nhập giới tính (MALE / FEMALE / OTHER): ");
                String genderStr = scanner.nextLine().trim().toUpperCase();
                try {
                    gender = Gender.valueOf(genderStr);
                } catch (IllegalArgumentException e) {
                    System.out.println("Giới tính phải là MALE, FEMALE hoặc OTHER. Vui lòng nhập lại.");
                }
            }

            System.out.print("Nhập địa chỉ (không bắt buộc): ");
            String address = scanner.nextLine().trim();

            LocalDate birthday = null;
            while (true) {
                System.out.print("Nhập ngày sinh (dd/MM/yyyy, không bắt buộc): ");
                String birthdayStr = scanner.nextLine().trim();
                if (birthdayStr.isEmpty()) {
                    break;
                }
                try {
                    birthday = Validator.validateBirthday(birthdayStr);
                    break;
                } catch (InvalidDataException e) {
                    System.out.println("Lỗi: " + e.getMessage() + " Vui lòng nhập lại.");
                }
            }

            System.out.print("Nhập email (không bắt buộc): ");
            String email = scanner.nextLine().trim();
            if (!email.isEmpty()) {
                Validator.validateEmail(email);
            }

            System.out.print("Nhập ghi chú (không bắt buộc): ");
            String notes = scanner.nextLine().trim();

            Contact newContact = new Contact(null, phone, fullName, group, gender, address, birthday, email, notes);
            contactService.addContact(newContact);

            System.out.println("Đã thêm danh bạ thành công!");
        } catch (AppException e) {
            System.out.println("Lỗi: " + e.getMessage());
            AppLogger.error("Lỗi khi thêm danh bạ", e);
        }
    }

    private void updateContactFlow() {
        System.out.println("\n--- CẬP NHẬT DANH BẠ ---");
        try {
            System.out.print("Nhập số điện thoại cần sửa: ");
            String oldPhone = scanner.nextLine().trim();
            
            Contact existing = contactService.findByPhone(oldPhone);
            if (existing == null) {
                throw new ContactNotFoundException("Không tìm thấy số điện thoại " + oldPhone + " trong danh bạ.");
            }

            System.out.println("Thông tin hiện tại của danh bạ (Nhấn Enter để giữ nguyên):");
            System.out.println("  Họ tên: " + existing.getFullName());
            System.out.println("  Số điện thoại: " + existing.getPhone());
            System.out.println("  Nhóm: " + existing.getGroup());
            System.out.println("  Giới tính: " + existing.getGender());
            System.out.println("  Địa chỉ: " + (existing.getAddress().isEmpty() ? "(trống)" : existing.getAddress()));
            String bdayStr = existing.getBirthday() != null ? existing.getBirthday().format(Validator.DATE_FORMATTER) : "(trống)";
            System.out.println("  Ngày sinh: " + bdayStr);
            System.out.println("  Email: " + (existing.getEmail().isEmpty() ? "(trống)" : existing.getEmail()));
            System.out.println("  Ghi chú: " + (existing.getNotes().isEmpty() ? "(trống)" : existing.getNotes()));

            System.out.println("\nNhập thông tin mới:");
            
            System.out.print("Họ tên (" + existing.getFullName() + "): ");
            String fullName = scanner.nextLine().trim();
            if (fullName.isEmpty()) fullName = existing.getFullName();

            System.out.print("Số điện thoại (" + existing.getPhone() + "): ");
            String phone = scanner.nextLine().trim();
            if (phone.isEmpty()) phone = existing.getPhone();
            Validator.validatePhone(phone);

            System.out.print("Nhóm (" + existing.getGroup() + "): ");
            String group = scanner.nextLine().trim();
            if (group.isEmpty()) group = existing.getGroup();

            Gender gender = existing.getGender();
            while (true) {
                System.out.print("Giới tính (" + existing.getGender() + ") [MALE/FEMALE/OTHER]: ");
                String genderStr = scanner.nextLine().trim().toUpperCase();
                if (genderStr.isEmpty()) {
                    break;
                }
                try {
                    gender = Gender.valueOf(genderStr);
                    break;
                } catch (IllegalArgumentException e) {
                    System.out.println("Giới tính không hợp lệ. Chỉ chấp nhận MALE, FEMALE hoặc OTHER.");
                }
            }

            System.out.print("Địa chỉ (" + (existing.getAddress().isEmpty() ? "trống" : existing.getAddress()) + "): ");
            String address = scanner.nextLine().trim();
            if (address.isEmpty()) address = existing.getAddress();

            LocalDate birthday = existing.getBirthday();
            while (true) {
                System.out.print("Ngày sinh (" + bdayStr + ") [dd/MM/yyyy]: ");
                String birthdayInput = scanner.nextLine().trim();
                if (birthdayInput.isEmpty()) {
                    break;
                }
                try {
                    birthday = Validator.validateBirthday(birthdayInput);
                    break;
                } catch (InvalidDataException e) {
                    System.out.println("Lỗi: " + e.getMessage() + " Vui lòng nhập lại.");
                }
            }

            System.out.print("Email (" + (existing.getEmail().isEmpty() ? "trống" : existing.getEmail()) + "): ");
            String email = scanner.nextLine().trim();
            if (email.isEmpty()) {
                email = existing.getEmail();
            } else {
                Validator.validateEmail(email);
            }

            System.out.print("Ghi chú (" + (existing.getNotes().isEmpty() ? "trống" : existing.getNotes()) + "): ");
            String notes = scanner.nextLine().trim();
            if (notes.isEmpty()) notes = existing.getNotes();

            Contact updatedContact = new Contact(existing.getId(), phone, fullName, group, gender, address, birthday, email, notes);
            contactService.updateContact(oldPhone, updatedContact);
            System.out.println("Cập nhật danh bạ thành công!");
        } catch (AppException e) {
            System.out.println("Lỗi: " + e.getMessage());
            AppLogger.error("Lỗi khi cập nhật danh bạ", e);
        }
    }

