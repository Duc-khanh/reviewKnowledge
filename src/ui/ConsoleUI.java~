    private void searchContactsFlow() {
        System.out.println("\n--- TÌM KIẾM NÂNG CAO ---");
        System.out.println("Tìm kiếm theo:");
        System.out.println("  1. Số điện thoại (gần đúng)");
        System.out.println("  2. Họ tên (gần đúng, không phân biệt dấu)");
        System.out.println("  3. Nhóm (chính xác)");
        System.out.println("  4. Tìm kiếm kết hợp nhiều tiêu chí");
        System.out.print("Chọn: ");
        String option = scanner.nextLine().trim();

        List<Contact> all = contactService.getAllContacts();
        List<Contact> result = new ArrayList<>();

        switch (option) {
            case "1":
                System.out.print("Nhập số điện thoại tìm kiếm: ");
                String phoneQuery = scanner.nextLine().trim();
                result = searchService.searchByPhone(all, phoneQuery);
                break;
            case "2":
                System.out.print("Nhập họ tên tìm kiếm (không cần gõ dấu): ");
                String nameQuery = scanner.nextLine().trim();
                result = searchService.searchByName(all, nameQuery);
                break;
            case "3":
                System.out.print("Nhập nhóm tìm kiếm (chính xác): ");
                String groupQuery = scanner.nextLine().trim();
                result = searchService.searchByGroup(all, groupQuery);
                break;
            case "4":
                System.out.print("Nhập họ tên (Enter để bỏ qua): ");
                String combName = scanner.nextLine().trim();
                System.out.print("Nhập nhóm (Enter để bỏ qua): ");
                String combGroup = scanner.nextLine().trim();
                System.out.print("Nhập giới tính (MALE/FEMALE/OTHER, Enter để bỏ qua): ");
                String combGenderStr = scanner.nextLine().trim().toUpperCase();
                Gender combGender = null;
                if (!combGenderStr.isEmpty()) {
                    try {
                        combGender = Gender.valueOf(combGenderStr);
                    } catch (IllegalArgumentException e) {
                        System.out.println("Giới tính không hợp lệ, không lọc theo giới tính.");
                    }
                }
                result = searchService.searchCombined(all, combName, combGroup, combGender);
                break;
            default:
                System.out.println("Lựa chọn không hợp lệ.");
                return;
        }

        System.out.println("\nTìm thấy " + result.size() + " danh bạ phù hợp.");
        printTable(result);
    }

